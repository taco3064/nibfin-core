[
  "name: Nibfin upgrade execution",
  "run-name: Nibfin upgrade · repository ${{ inputs.repository_id }} · PR ${{ inputs.pull_number }}",
  "on:",
  "  workflow_dispatch:",
  "    inputs:",
  "      repository_id: { required: true, type: string }",
  "      pull_number: { required: true, type: string }",
  "permissions:",
  "  actions: read",
  "  checks: read",
  "  contents: read",
  "  id-token: write",
  "concurrency:",
  "  group: nibfin-upgrade-${{ inputs.repository_id }}-${{ inputs.pull_number }}",
  "  cancel-in-progress: false",
  "jobs:",
  "  nibfin-upgrade:",
  "    runs-on: [self-hosted, linux, nibfin-shared, nibfin-user-MEMBER_ID]",
  "    steps:",
  "      - name: Continue the authorized upgrade",
  "        env:",
  "          REPOSITORY_ID: ${{ inputs.repository_id }}",
  "          PULL_NUMBER: ${{ inputs.pull_number }}",
  "        shell: bash --noprofile --norc -e {0}",
  "        run: |",
  "          /usr/bin/python3 -I /usr/local/libexec/nibfin/core-rollout/client.py upgrade \\",
  "            \"$REPOSITORY_ID\" \"$PULL_NUMBER\"",
  ""
]
