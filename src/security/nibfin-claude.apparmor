# Derived from codex-security.apparmor, copied from openai/codex-security commit
# 3fa6215fc1021bbee546a61f8b407bcd521953f0 (Apache-2.0; see LICENSE). The only
# differences: the profile and its self peers are named nibfin-claude-container,
# and every process environ read is denied.

abi <abi/4.0>,

include <tunables/global>

profile nibfin-claude-container flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  unix,
  deny network alg,
  capability,
  file,

  mount,
  # Keep the container PID view used by the tool sandbox.
  deny mount fstype=proc,
  umount,
  pivot_root,
  userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=nibfin-claude-container,

  deny @{PROC}/* w,
  deny @{PROC}/[^1-9/]/** w,
  deny @{PROC}/[^1-9/][^0-9/]/** w,
  deny @{PROC}/[^1-9s/][^0-9y/][^0-9s/]/** w,
  deny @{PROC}/[^1-9/][^0-9/][^0-9/][^0-9/]*/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/*/environ r,
  deny @{PROC}/*/task/*/environ r,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Permit normal procfs metadata without cross-process introspection.
  deny ptrace (trace,tracedby,read,readby) peer=nibfin-claude-container,
}
