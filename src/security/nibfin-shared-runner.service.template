[Unit]
Description=Nibfin shared GitHub Actions Runner slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nibfin-runner-%i
Group=nibfin-runner-%i
WorkingDirectory=/var/lib/nibfin/runners/slot-%i
ExecStartPre=/bin/sh -ec 'v=$$(/bin/cat /opt/nibfin/core/.node-version); case "$$v" in ""|*[!0-9.]*) exit 1;; esac; exec /usr/bin/env -i PATH=/usr/bin:/bin /opt/nibfin/tools/node-v"$$v"-linux-x64/bin/node /opt/nibfin/core/src/security/shared-runner-start-check.mjs %i'
ExecStart=/var/lib/nibfin/runners/slot-%i/bin/runsvc.sh
UMask=0077
PrivateTmp=yes
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
