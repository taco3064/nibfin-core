{
  "wake": [
    "name: Nibfin adopted wake",
    "run-name: >-",
    "  Wake · ${{ format('{0}#{1}',",
    "  inputs.repository_id == github.repository_id && github.repository ||",
    "  format('repository ID {0}', inputs.repository_id), inputs.issue_number) }}",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      issue_number: { required: true, type: string }",
    "      issue_id: { required: true, type: string }",
    "      repository_id: { required: true, type: string }",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-${{ github.repository_id }}-${{ inputs.issue_number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  wake:",
    "    uses: \"taco3064/nibfin-core/.github/workflows/wake.yml@\\",
    "      CORE_COMMIT\"",
    "    with:",
    "      core_commit: CORE_COMMIT",
    "    secrets:",
    "      NIBFIN_WAKE_ADOPTION: ${{ secrets.NIBFIN_WAKE_ADOPTION }}",
    "      NIBFIN_READ_TOKEN: ${{ secrets.NIBFIN_READ_TOKEN }}",
    ""
  ],
  "action-wake": [
    "name: Nibfin adopted Action wake",
    "run-name: >-",
    "  Auto · ${{ github.repository }}#${{ inputs.issue_number }}",
    "# Core source: CORE_COMMIT",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      issue_number: { required: true, type: string }",
    "      issue_id: { required: true, type: string }",
    "      repository_id: { required: true, type: string }",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-${{ github.repository_id }}-${{ inputs.issue_number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  adopted-stage:",
    "    runs-on: [self-hosted, Linux, nibfin-user-MEMBER_ID]",
    "    timeout-minutes: 180",
    "    steps:",
    "      - uses: \"taco3064/nibfin-act@\\",
    "          ACTION_COMMIT\"",
    "        with:",
    "          issue-number: ${{ inputs.issue_number }}",
    "          stage: continue",
    ""
  ],
  "action-dispatch": [
    "name: Nibfin adopted dispatch",
    "run-name: >-",
    "  ${{",
    "  inputs.stage == 'shape' && 'Shape' ||",
    "  inputs.stage == 'validate-shape' && 'Validate Shape' ||",
    "  inputs.stage == 'publish-shape' && 'Publish Shape' ||",
    "  inputs.stage == 'deliver' && 'Deliver' ||",
    "  inputs.stage == 'pre-accept-hooks' && 'Pre-Accept Hooks' ||",
    "  inputs.stage == 'accept' && 'Accept' ||",
    "  inputs.stage == 'post-accept-hooks' && 'Post-Accept Hooks' ||",
    "  inputs.stage == 'commit-pr' && 'Create PR' ||",
    "  inputs.stage == 'review-pr' && 'Review PR' ||",
    "  inputs.stage == 'merge' && 'Merge' ||",
    "  inputs.stage == 'close' && 'Close' ||",
    "  'Auto' }} · ${{ github.repository }}#${{ inputs.issue_number }}",
    "# Core source: CORE_COMMIT",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      issue_number: { required: true, type: string }",
    "      issue_id: { required: false, type: string }",
    "      repository_id: { required: false, type: string }",
    "      stage: { required: false, type: string, default: continue }",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-${{ github.repository_id }}-${{ inputs.issue_number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  adopted-stage:",
    "    runs-on: [self-hosted, Linux, nibfin-user-MEMBER_ID]",
    "    timeout-minutes: 180",
    "    steps:",
    "      - uses: \"taco3064/nibfin-act@\\",
    "          ACTION_COMMIT\"",
    "        with:",
    "          issue-number: ${{ inputs.issue_number }}",
    "          stage: ${{ inputs.stage }}",
    ""
  ],
  "issue": [
    "name: Nibfin Issue wake",
    "run-name: >-",
    "  Wake · ${{ github.repository }}#${{ github.event.issue.number }}",
    "  · ${{ github.event.action }}${{",
    "  github.event.label.name && format(' {0}', github.event.label.name) || '' }}",
    "on:",
    "  issues:",
    "    types:",
    "      - opened",
    "      - edited",
    "      - labeled",
    "      - unlabeled",
    "      - assigned",
    "      - unassigned",
    "      - reopened",
    "      - closed",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-event-${{ github.repository_id }}-${{ github.event.issue.number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  wake:",
    "    uses: \"taco3064/nibfin-core/.github/workflows/issue.yml@\\",
    "      CORE_COMMIT\"",
    "    with:",
    "      core_commit: CORE_COMMIT",
    "    secrets:",
    "      NIBFIN_WAKE_ADOPTION: ${{ secrets.NIBFIN_WAKE_ADOPTION }}",
    "      NIBFIN_WAKE_TOKEN: ${{ secrets.NIBFIN_WAKE_TOKEN }}",
    ""
  ],
  "issue-managed": [
    "name: Nibfin Issue wake",
    "run-name: >-",
    "  Wake · ${{ github.repository }}#${{ github.event.issue.number }}",
    "  · ${{ github.event.action }}${{",
    "  github.event.label.name && format(' {0}', github.event.label.name) || '' }}",
    "on:",
    "  issues:",
    "    types:",
    "      - opened",
    "      - edited",
    "      - labeled",
    "      - unlabeled",
    "      - assigned",
    "      - unassigned",
    "      - reopened",
    "      - closed",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-event-${{ github.repository_id }}-${{ github.event.issue.number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  wake:",
    "    uses: \"taco3064/nibfin-core/.github/workflows/issue.yml@\\",
    "      CORE_COMMIT\"",
    "    with:",
    "      core_commit: CORE_COMMIT",
    "      mode: managed",
    ""
  ]
}
