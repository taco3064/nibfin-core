{
  "wake": [
    "name: Nibfin adopted wake",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      issue_number: { required: true, type: string }",
    "      issue_id: { required: true, type: string }",
    "      repository_id: { required: true, type: string }",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-${{ github.repository_id }}-${{ inputs.issue_number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  wake:",
    "    uses: \"taco3064/nibfin-core/.github/workflows/wake.yml@\\",
    "      CORE_COMMIT\"",
    "    with:",
    "      core_commit: CORE_COMMIT",
    "    secrets:",
    "      NIBFIN_WAKE_ADOPTION: ${{ secrets.NIBFIN_WAKE_ADOPTION }}",
    "      NIBFIN_READ_TOKEN: ${{ secrets.NIBFIN_READ_TOKEN }}",
    ""
  ],
  "action-wake": [
    "name: Nibfin adopted Action wake",
    "# Core source: CORE_COMMIT",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      issue_number: { required: true, type: string }",
    "      issue_id: { required: true, type: string }",
    "      repository_id: { required: true, type: string }",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-${{ github.repository_id }}-${{ inputs.issue_number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  adopted-stage:",
    "    runs-on: [self-hosted, Linux, nibfin-user-MEMBER_ID]",
    "    steps:",
    "      - uses: \"taco3064/nibfin-act@\\",
    "          ACTION_COMMIT\"",
    "        with:",
    "          issue-number: ${{ inputs.issue_number }}",
    "          stage: continue",
    ""
  ],
  "issue": [
    "name: Nibfin Issue wake",
    "on:",
    "  issues:",
    "    types:",
    "      - opened",
    "      - edited",
    "      - labeled",
    "      - unlabeled",
    "      - assigned",
    "      - unassigned",
    "      - reopened",
    "      - closed",
    "permissions:",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-event-${{ github.repository_id }}-${{ github.event.issue.number }}",
    "  cancel-in-progress: false",
    "jobs:",
    "  wake:",
    "    uses: \"taco3064/nibfin-core/.github/workflows/issue.yml@\\",
    "      CORE_COMMIT\"",
    "    with:",
    "      core_commit: CORE_COMMIT",
    "    secrets:",
    "      NIBFIN_WAKE_ADOPTION: ${{ secrets.NIBFIN_WAKE_ADOPTION }}",
    "      NIBFIN_WAKE_TOKEN: ${{ secrets.NIBFIN_WAKE_TOKEN }}",
    ""
  ]
}
