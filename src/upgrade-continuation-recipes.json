{
  "notification": [
    "name: Nibfin upgrade notification",
    "run-name: Nibfin upgrade notification · PR ${{ inputs.pull_number || github.event.pull_request.number }}",
    "on:",
    "  pull_request:",
    "    types: [closed]",
    "  workflow_dispatch:",
    "    inputs:",
    "      pull_number: { required: true, type: string }",
    "permissions:",
    "  contents: read",
    "jobs:",
    "  notify:",
    "    if: >-",
    "      github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&",
    "      (github.event_name == 'workflow_dispatch' ||",
    "       (github.event.pull_request.merged &&",
    "        github.event.pull_request.head.repo.id == github.event.repository.id &&",
    "        github.event.pull_request.head.ref == 'nibfin/upgrade'))",
    "    runs-on: ubuntu-24.04",
    "    steps:",
    "      - name: Route the native upgrade proposal",
    "        env:",
    "          GH_TOKEN: ${{ secrets.NIBFIN_UPGRADE_DISPATCH_TOKEN }}",
    "          DESTINATION: ${{ vars.NIBFIN_UPGRADE_DESTINATION }}",
    "          REPOSITORY_ID: ${{ github.repository_id }}",
    "          PULL_NUMBER: ${{ inputs.pull_number || github.event.pull_request.number }}",
    "        shell: bash --noprofile --norc -e {0}",
    "        run: |",
    "          [[ \"$REPOSITORY_ID\" =~ ^[1-9][0-9]*$ &&",
    "             \"$PULL_NUMBER\" =~ ^[1-9][0-9]*$ &&",
    "             \"$DESTINATION\" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]",
    "          gh workflow run nibfin-upgrade-execute.yml --repo \"$DESTINATION\" \\",
    "            -f repository_id=\"$REPOSITORY_ID\" -f pull_number=\"$PULL_NUMBER\"",
    ""
  ],
  "execution": [
    "name: Nibfin upgrade execution",
    "run-name: ${{ inputs.cd_run_id && format('Core maintenance · CD {0} · artifact {1}', inputs.cd_run_id, inputs.activation_artifact_id) || format('Nibfin upgrade · repository {0} · PR {1}', inputs.repository_id, inputs.pull_number) }}",
    "on:",
    "  workflow_dispatch:",
    "    inputs:",
    "      repository_id: { required: false, type: string }",
    "      pull_number: { required: false, type: string }",
    "      cd_run_id: { required: false, type: string }",
    "      activation_artifact_id: { required: false, type: string }",
    "permissions:",
    "  actions: read",
    "  checks: read",
    "  contents: read",
    "  id-token: write",
    "concurrency:",
    "  group: nibfin-core-maintenance",
    "  queue: max",
    "  cancel-in-progress: false",
    "jobs:",
    "  nibfin-upgrade:",
    "    if: inputs.repository_id != '' && inputs.pull_number != '' && inputs.cd_run_id == '' && inputs.activation_artifact_id == ''",
    "    runs-on: [self-hosted, linux, nibfin-shared, nibfin-user-MEMBER_ID]",
    "    steps:",
    "      - name: Continue the authorized upgrade",
    "        env:",
    "          REPOSITORY_ID: ${{ inputs.repository_id }}",
    "          PULL_NUMBER: ${{ inputs.pull_number }}",
    "        shell: bash --noprofile --norc -e {0}",
    "        run: |",
    "          /usr/bin/python3 -I /usr/local/libexec/nibfin/core-rollout/client.py upgrade \\",
    "            \"$REPOSITORY_ID\" \"$PULL_NUMBER\"",
    "  core-maintenance:",
    "    if: inputs.cd_run_id != '' && inputs.activation_artifact_id != '' && inputs.repository_id == '' && inputs.pull_number == ''",
    "    runs-on: [self-hosted, linux, nibfin-shared, nibfin-user-MEMBER_ID]",
    "    steps:",
    "      - name: Apply Core through the installed administrator",
    "        shell: bash --noprofile --norc -e {0}",
    "        env:",
    "          NIBFIN_CD_RUN_ID: ${{ inputs.cd_run_id }}",
    "          NIBFIN_ACTIVATION_ARTIFACT_ID: ${{ inputs.activation_artifact_id }}",
    "          GH_TOKEN: ${{ github.token }}",
    "        run: |",
    "          /usr/bin/python3 -I /usr/local/libexec/nibfin/core-rollout/client.py \\",
    "            \"$NIBFIN_CD_RUN_ID\" \"$NIBFIN_ACTIVATION_ARTIFACT_ID\"",
    ""
  ]
}
