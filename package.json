{
  "name": "nibfin-core",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Trusted delivery engine, Skills, and reusable workflows for Nibfin",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run website:check && npm run check && npm test && npm run website:ci",
    "website:check": "npm run check --workspace website",
    "website:build": "npm run build --workspace website",
    "website:preview": "npm run preview --workspace website --",
    "website:ci": "node website/scripts/ci-check.mjs",
    "website:verify-failure": "node website/scripts/verify-failure.mjs",
    "website:negative": "node website/scripts/negative-check.mjs",
    "website:preview-check": "node website/scripts/preview-check.mjs",
    "website:theme": "node website/scripts/theme-source.mjs && node website/scripts/theme-controls.mjs",
    "website:browser": "node website/scripts/theme-browser.mjs"
  },
  "exports": {
    ".": "./src/public-api.mjs"
  },
  "bin": {
    "nibfin-core": "./bin/nibfin-core.mjs"
  },
  "workspaces": [
    "website"
  ]
}
