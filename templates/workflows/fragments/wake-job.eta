    name: wake
    runs-on: ubuntu-24.04
    steps:
      # Core's wake (src/route/wake.ts): it reads the event from the runner's event
      # file, filters it, and dispatches a route run, or asks a person on failure.
      - name: Wake the Issue
        uses: <%~ it.actionUses %>
        with:
          command: wake
          token: <%~ it.eventsToken %>
          execution-repo: ${{ vars.NIBFIN_EXECUTION_REPO }}
