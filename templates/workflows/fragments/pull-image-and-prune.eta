      - name: Pull the image and remove older ones
        id: image
        run: |
<% if (it.channel === "user") { -%>
          podman pull "$IMAGE_REF"
          id=$(podman image inspect --format '{{.Id}}' "$IMAGE_REF")
          echo "Nibfin image: $IMAGE_REF"
          echo "ref=$IMAGE_REF" >> "$GITHUB_OUTPUT"
<% } else { -%>
          podman pull "$IMAGE:<%~ it.imageTag %>"
          id=$(podman image inspect --format '{{.Id}}' "$IMAGE:<%~ it.imageTag %>")
          digest=$(podman image inspect --format '{{.Digest}}' "$IMAGE:<%~ it.imageTag %>")
          echo "Nibfin image: $IMAGE@$digest"
          echo "ref=$IMAGE@$digest" >> "$GITHUB_OUTPUT"
<% } -%>
          podman images --format '{{.ID}} {{.Repository}}' | sort -u |
            while read -r other repository; do
              if [ "$repository" != "$IMAGE" ]; then
                continue
              fi
              case "$id" in
                "$other"*) continue ;;
              esac
              podman image rm "$other" || echo "Kept image $other: podman refused to remove it"
            done
          podman image prune -f
